# Optional. When unset, the test suite starts a local stub somes server on an
# ephemeral port automatically - no external services required.
#
# Set this to run the same suite against a real somes-api instance instead
# (e.g. a locally dockerised one). Note the suite creates users and requests
# OTPs, so never point it at production.
# SOMES_API_URL=http://127.0.0.1:8080
